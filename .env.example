# Kopiera till .env och fyll i. Filen läses bara av servern och skickas aldrig till webbläsaren.
# Rekommenderat för nycklar och lösenord: lämna dem tomma här och kör
#   python scripts/spara_hemlighet.py ANTHROPIC_API_KEY
# så sparas de i ~/.config/klimathemmet-studio/, utanför projektet.
# Nycklarna behövs först i senare steg; förhandsgranskningen fungerar utan dem.

# Steg 2 – AI-text (Claude)
ANTHROPIC_API_KEY=
# Valfritt: modell och hur grundligt Claude tänker (low | medium | high | xhigh | max)
STUDIO_CLAUDE_MODEL=claude-opus-5-5
STUDIO_CLAUDE_EFFORT=high

# Steg 3 – bildgenerering
OPENAI_API_KEY=

# Steg 4 – WordPress (applikationslösenord, inte ditt vanliga lösenord)
WP_URL=https://klimathemmet.se
WP_USER=
WP_APP_PASSWORD=

# Inloggning till själva studion (rekommenderas när appen ligger på en server)
STUDIO_USER=
STUDIO_PASSWORD=

# Sessionsnyckel för inloggningen (krävs i produktion, minst 32 tecken). Skapa med:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
STUDIO_SESSION_SECRET=

# Publiceringsläge: simulering (standard) | utkast | skarp. Se DRIFT.md innan du ändrar.
STUDIO_PUBLICERING=simulering
